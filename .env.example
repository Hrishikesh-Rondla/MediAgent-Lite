# Copy this file to .env and fill in your keys
# At minimum, set one LLM provider key for real runs.
# Tests use FakeLLM and require NO keys.

# --- LLM Providers ---
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- PubMed E-utilities ---
# Required for EvidenceScanner real runs (not tests). Just your email.
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=  # Optional: raises rate limit from 3 to 10 req/s

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mediagent-lite

# --- Runtime ---
# Override the default LLM provider: gemini | groq | ollama | fake
DEFAULT_LLM_PROVIDER=gemini
